{
  "name": "writer",
  "productName": "Writer",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, local, Markdown-first writing app for macOS.",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-assets.mjs",
    "dev": "node scripts/copy-assets.mjs && concurrently -k -n vite,app \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/copy-assets.mjs && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-character-count": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "harper.js": "^2.13.0",
    "prosemirror-highlight": "^0.16.0",
    "prosemirror-markdown": "^1.13.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.5.0",
    "tiptap-markdown": "^0.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.alexmackenzie.writer",
    "productName": "Writer",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Writer"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "role": "Editor"
      }
    ]
  }
}
